{
  "name": "dailydash",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "vite preview --config web-vue/vite.config.js --host 127.0.0.1",
    "personal:path": "node scripts/personal-data.js path",
    "personal:export": "node scripts/personal-data.js export",
    "personal:import": "node scripts/personal-data.js import",
    "dev": "vite --config web-vue/vite.config.js --host 127.0.0.1",
    "build": "vite build --config web-vue/vite.config.js",
    "preview": "vite preview --config web-vue/vite.config.js --host 127.0.0.1",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "node --test tests/*.test.js",
    "crawler": "node crawler/cron-run.js",
    "prebuild": "node scripts/publish-data.js",
    "data:validate": "node scripts/validate-data.js",
    "data:publish": "node scripts/publish-data.js",
    "schedule:install": "powershell -NoProfile -File scripts/install-schedule.ps1",
    "schedule:preview": "powershell -NoProfile -File scripts/install-schedule.ps1 -Preview",
    "schedule:remove": "powershell -NoProfile -File scripts/install-schedule.ps1 -Remove"
  },
  "dependencies": {
    "cheerio": "^1.2.0",
    "lucide-vue-next": "^0.468.0",
    "opencc-js": "^1.4.2",
    "robots-parser": "^3.0.1",
    "vue": "^3.5.24",
    "vue-router": "^4.6.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@vitejs/plugin-vue": "^6.0.2",
    "eslint": "^9.39.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-vue": "^10.6.1",
    "globals": "^16.5.0",
    "prettier": "^3.6.2",
    "unplugin-auto-import": "^20.3.0",
    "unplugin-vue-components": "^30.0.0",
    "vite": "^7.2.2"
  }
}
